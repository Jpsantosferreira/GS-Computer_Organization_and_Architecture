// ============================================================
// Sistema IoT para Monitoramento de uma Cápsula Espacial
// ============================================================

#include <Wire.h>
#include <LiquidCrystal_I2C.h>

#define PIN_LDR       A0
#define PIN_TMP36     A1
#define PIN_VIBRACAO  A2
#define PIN_BUZZER1   5
#define PIN_BUZZER2   6
#define PIN_LED_VERDE 7
#define PIN_LED_VERM  8

#define TEMP_ALERTA   35.0
#define TEMP_CRITICA  45.0
#define LUZ_BAIXA     20
#define VIB_LIMIAR    512

LiquidCrystal_I2C lcd(0x27, 16, 2);

float  temperatura  = 0.0;
int    luminosidade = 0;
bool   vibracao     = false;
bool   alertaTemp   = false;
bool   alertaLuz    = false;   
bool   alertaVib    = false;
bool   sistemaOK    = true;
String status       = "NORMAL ";

unsigned long tLeitura = 0;
unsigned long tTela    = 0;
unsigned long tBuz1    = 0;
unsigned long tBuz2    = 0;
int  telaAtual = 0;
bool b1 = false, b2 = false;

void setup() {
  Serial.begin(9600);

  pinMode(PIN_BUZZER1,   OUTPUT);
  pinMode(PIN_BUZZER2,   OUTPUT);
  pinMode(PIN_LED_VERDE, OUTPUT);
  pinMode(PIN_LED_VERM,  OUTPUT);
  digitalWrite(PIN_BUZZER1,   LOW);
  digitalWrite(PIN_BUZZER2,   LOW);
  digitalWrite(PIN_LED_VERDE, LOW);
  digitalWrite(PIN_LED_VERM,  LOW);

  lcd.init();
  lcd.backlight();
  lcd.clear();

  lcd.setCursor(0, 0); lcd.print("Capsula Espacial");
  lcd.setCursor(3, 1); lcd.print("Iniciando...");

  for (int i = 0; i < 3; i++) {
    digitalWrite(PIN_LED_VERDE, HIGH);
    digitalWrite(PIN_LED_VERM,  HIGH);
    delay(300);
    digitalWrite(PIN_LED_VERDE, LOW);
    digitalWrite(PIN_LED_VERM,  LOW);
    delay(300);
  }
  lcd.clear();
}

void loop() {
  unsigned long agora = millis();

  if (agora - tLeitura >= 500) {
    tLeitura = agora;
    lerSensores();
    avaliarStatus();
    atualizarLEDs();
  }

  if (agora - tTela >= 3000) {
    tTela = agora;
    mostrarTela(telaAtual);
    telaAtual = (telaAtual + 1) % 3;
  }

  // Buzzer 1: alerta de temperatura
  if (alertaTemp) {
    unsigned long inv = (temperatura >= TEMP_CRITICA) ? 120 : 500;
    if (agora - tBuz1 >= inv) {
      tBuz1 = agora;
      b1 = !b1;
      if (b1) tone(PIN_BUZZER1, 1000);
      else    noTone(PIN_BUZZER1);
    }
  } else {
    noTone(PIN_BUZZER1);
    b1 = false;
  }

  // Buzzer 2: vibração ou luz baixa 
  if (alertaVib || alertaLuz) {
    unsigned long freq = alertaVib ? 2500 : 800;
    if (agora - tBuz2 >= 180) {
      tBuz2 = agora;
      b2 = !b2;
      if (b2) tone(PIN_BUZZER2, freq);
      else    noTone(PIN_BUZZER2);
    }
  } else {
    noTone(PIN_BUZZER2);
    b2 = false;
  }
}

void lerSensores() {
  int rawT = analogRead(PIN_TMP36);
  temperatura = ((rawT * (5000.0 / 1024.0)) - 500.0) / 10.0;

  int rawL = analogRead(PIN_LDR);
  luminosidade = map(rawL, 0, 1023, 0, 100);

  int rawV = analogRead(PIN_VIBRACAO);
  vibracao = (rawV < VIB_LIMIAR);

  Serial.print("T:"); Serial.print(temperatura, 1);
  Serial.print(" L:"); Serial.print(luminosidade);
  Serial.print(" Vib:"); Serial.println(vibracao ? "SIM" : "NAO");
}

void avaliarStatus() {
  alertaTemp = (temperatura >= TEMP_ALERTA);
  alertaLuz  = (luminosidade < LUZ_BAIXA);   
  alertaVib  = vibracao;
  sistemaOK  = (!alertaTemp && !alertaVib && !alertaLuz);

  if      (temperatura >= TEMP_CRITICA || vibracao) status = "CRITICO";
  else if (alertaTemp || alertaLuz)                 status = "ALERTA ";
  else                                              status = "NORMAL ";
}

void atualizarLEDs() {
  if (sistemaOK) {
    digitalWrite(PIN_LED_VERDE, HIGH);
    digitalWrite(PIN_LED_VERM,  LOW);
  } else {
    digitalWrite(PIN_LED_VERDE, LOW);
    digitalWrite(PIN_LED_VERM, (millis() / 400) % 2);
  }
}

void mostrarTela(int t) {
  lcd.clear();
  switch (t) {
    case 0:
      lcd.setCursor(0, 0);
      lcd.print("Temp:");
      lcd.print(temperatura, 1);
      lcd.print("C");
      if (alertaTemp) { lcd.setCursor(12, 0); lcd.print("(!!)"); }
      lcd.setCursor(0, 1);
      lcd.print("Luz:");
      lcd.print(luminosidade);
      lcd.print("%");
      if (alertaLuz) { lcd.setCursor(10, 1); lcd.print("(!!)"); } // NOVO
      break;
    case 1:
      lcd.setCursor(0, 0);
      lcd.print("Vibracao:");
      lcd.setCursor(0, 1);
      lcd.print(vibracao ? "IMPACTO! !!!" : "Normal      ");
      break;
    case 2:
      lcd.setCursor(0, 0);
      lcd.print("STATUS CAPSULA:");
      lcd.setCursor(0, 1);
      lcd.print(">> "); lcd.print(status);
      break;
  }
}
